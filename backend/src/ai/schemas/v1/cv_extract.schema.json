{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cv_extract.v1",
  "title": "cv_extract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "summary",
    "education",
    "experience",
    "skills",
    "projects",
    "certifications"
  ],
  "properties": {
    "language": {
      "enum": [
        "vi",
        "en",
        "mixed"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    },
    "education": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "school",
          "degree",
          "field",
          "startDate",
          "endDate",
          "gpa"
        ],
        "properties": {
          "school": {
            "type": "string",
            "maxLength": 150
          },
          "degree": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "field": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "gpa": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company",
          "title",
          "startDate",
          "endDate",
          "isCurrent",
          "bullets"
        ],
        "properties": {
          "company": {
            "type": "string",
            "maxLength": 150
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          },
          "isCurrent": {
            "type": "boolean"
          },
          "bullets": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "level": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role",
          "description",
          "technologies"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          },
          "technologies": {
            "type": "array",
            "maxItems": 15,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          }
        }
      }
    },
    "certifications": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "issuer",
          "date"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "issuer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 150
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
          }
        }
      }
    }
  }
}
