{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "job_skills.v1",
  "title": "job_skills v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skills"
  ],
  "properties": {
    "skills": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "isRequired",
          "weight"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "isRequired": {
            "type": "boolean"
          },
          "weight": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2
          }
        }
      }
    }
  }
}
