{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fit_assess.v1",
  "title": "fit_assess v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score",
    "strengths",
    "gaps",
    "advice",
    "evidenceThin"
  ],
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "strengths": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 140
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 140
      }
    },
    "advice": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 140
      }
    },
    "evidenceThin": {
      "type": "boolean"
    }
  }
}
