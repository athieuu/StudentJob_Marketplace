{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "job_rerank.v1",
  "title": "job_rerank v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ranking"
  ],
  "properties": {
    "ranking": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "reason"
        ],
        "properties": {
          "jobId": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    }
  }
}
